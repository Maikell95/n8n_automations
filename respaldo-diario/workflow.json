    {
      "id": "3612cecd-961e-4cb2-8a27-756047a00692",
      "name": "Comparar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        0
      ],
      "parameters": {
        "jsCode": "// GitHub devuelve el mismo sha de árbol si el contenido es idéntico: entonces no hay nada que guardar.\nconst anterior = $('Commit actual').first().json.tree.sha;\nconst nuevo = $json.sha;\nreturn [{ json: { cambio: anterior !== nuevo, arbol: nuevo, padre: $('Rama main').first().json.object.sha } }];\n"
      }
    },
