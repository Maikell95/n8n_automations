    {
      "id": "c134745c-6d59-44aa-b4c1-930d0a6bf08d",
      "name": "Preparar archivos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "// Un archivo por flujo y por tabla, sin los datos que cambian solos en cada ejecución\n// (staticData), para que el historial de GitHub solo muestre cambios reales.\nconst slug = s => String(s).normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');\nconst flujos = $('Flujos').first().json.data || [];\nconst archivos = [];\nfor (const w of flujos) {\n  const { id, name, active, nodes, connections, settings, tags, updatedAt } = w;\n  archivos.push({ path: `flujos/${slug(name)}.json`, content: JSON.stringify({ id, name, active, updatedAt, settings, tags, nodes, connections }, null, 2) + '\\n' });\n}\nconst tablas = $('Tablas').first().json.data || [];\nconst filas = $('Filas').all();\ntablas.forEach((t, i) => {\n  const rows = filas[i]?.json.data || [];\n  archivos.push({ path: `tablas/${slug(t.name)}.json`, content: JSON.stringify({ id: t.id, name: t.name, columns: t.columns.map(c => ({ name: c.name, type: c.type })), rows }, null, 2) + '\\n' });\n});\nconst hoy = $now.setZone('America/Havana').toFormat('yyyy-MM-dd');\nconst lista = archivos.map(a => '- `' + a.path + '`').join('\\n');\narchivos.push({ path: 'README.md', content: `# Respaldo de n8n\\n\\nCopia diaria automática de mis flujos y tablas de n8n. La hace el flujo **Respaldo diario**: solo crea un commit cuando algo cambió.\\n\\nÚltima comprobación: ${hoy} · ${flujos.length} flujos · ${tablas.length} tablas\\n\\n${lista}\\n` });\nreturn [{ json: { hoy, nFlujos: flujos.length, nTablas: tablas.length, archivos } }];\n"
      }
    },
