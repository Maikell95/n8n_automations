    {
      "id": "78c2cafd-f2c6-433b-b3c6-a19a5e73f20e",
      "name": "Preparar zip",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3080,
        0
      ],
      "parameters": {
        "jsCode": "// Mete todos los archivos en el item como binarios para comprimirlos juntos.\nconst p = $('Preparar archivos').first().json;\nconst cambio = $('Comparar').first().json.cambio;\nlet commit = null;\nif (cambio) { try { commit = $('Mover main').first().json.object?.sha; } catch {} }\nconst binary = {};\nconst nombres = [];\nfor (const [i, a] of p.archivos.entries()) {\n  const clave = 'f' + i;\n  binary[clave] = await this.helpers.prepareBinaryData(Buffer.from(a.content, 'utf8'), a.path.replace(/\\//g, '__'), 'application/json');\n  nombres.push(clave);\n}\nreturn [{ json: { ...p, archivos: undefined, cambio, commit, claves: nombres.join(',') }, binary }];\n"
      }
    },
    {
      "id": "a925d3af-8071-4050-badd-874d053b5800",
      "name": "Comprimir",
      "type": "n8n-nodes-base.compression",
