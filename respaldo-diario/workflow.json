    {
      "id": "79213e6b-59fd-44e7-ac3b-899690dcf06c",
      "name": "Armar árbol",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "jsCode": "// Árbol completo (sin base_tree): así un flujo borrado también desaparece del respaldo.\nconst p = $('Preparar archivos').first().json;\nreturn [{ json: { tree: p.archivos.map(a => ({ path: a.path, mode: '100644', type: 'blob', content: a.content })) } }];\n"
      }
    },
    {
      "id": "6d43fe80-810a-4878-a4b5-59542a4c4432",
      "name": "Subir árbol",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/TU_USUARIO/TU_REPO_DE_RESPALDO/git/trees",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
