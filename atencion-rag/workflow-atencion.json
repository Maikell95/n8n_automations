    {
      "name": "Config",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "executeOnce": true,
      "alwaysOutputData": true,
      "position": [
        880,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "https://TU_PROYECTO.supabase.co/rest/v1/config?select=clave,valor",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "options": {}
      },
      "credentials": {
        "httpCustomAuth": {
          "id": "",
