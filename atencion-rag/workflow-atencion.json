      "parameters": {
        "jsCode": "// Respuesta común: el chat de n8n lee \"output\"; el widget usa respuesta/sesion/fuentes.\nconst r = $('Interpretar respuesta').first().json;\nreturn [{ json: { output: r.respuesta, respuesta: r.respuesta, sesion: r.sesion, conversacion_id: r.conversacion_id, fuentes: r.fuentes, necesita_humano: r.necesita_humano } }];\n"
      },
