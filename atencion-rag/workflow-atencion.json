    {
      "name": "Webhook",
      "webhookId": "0e7d4c2a-91b5-4f36-8d0e-3b6a5f9c2e14",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        220
      ],
      "parameters": {
        "path": "atencion-rag",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "cf9cdb25-976e-40ff-ae27-e3f01022cfbb"
    },
    {
      "name": "Normalizar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        100
      ],
      "parameters": {
        "jsCode": "// Une las dos entradas: el chat integrado de n8n o el webhook { mensaje, sesion } de un widget.\nconst j = $json;\nconst desdeChat = j.chatInput !== undefined;\nconst mensaje = String(desdeChat ? j.chatInput : (j.body?.mensaje ?? '')).trim().slice(0, 1000);\nif (!mensaje) throw new Error('Falta \"mensaje\".');\nlet sesion = String(desdeChat ? j.sessionId : (j.body?.sesion ?? '')).trim().slice(0, 100);\nif (!sesion) sesion = 'n8n-' + Date.now().toString(36) + Math.random().toString(36).slice(2, 8);\nreturn [{ json: { mensaje, sesion, origen: desdeChat ? 'chat' : 'webhook' } }];\n"
      },
      "id": "58d62093-7991-4383-9c89-e4fbac81b2a4"
    },
    {
      "name": "Conversación",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "https://TU_PROYECTO.supabase.co/rest/v1/rpc/obtener_conversacion",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_canal: 'n8n', p_usuario: $json.sesion }) }}"
      },
      "credentials": {
        "httpCustomAuth": {
          "id": "",
