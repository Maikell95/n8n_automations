    {
      "name": "Interpretar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        100
      ],
      "parameters": {
        "jsCode": "// Limpia la respuesta y decide si hace falta una persona (marca [HUMANO] o el cliente la pidió).\nconst b = $('Construir prompt').first().json;\nlet texto = String($json.text || '').replace(/<think>[\\s\\S]*?<\\/think>/gi, '').trim();\nlet humano = b.pide_humano;\nif (texto.startsWith('[HUMANO]')) { humano = true; texto = texto.slice(8).trim(); }\ntexto = texto.replace(/\\[HUMANO\\]/g, '').trim();\nif (!texto) {\n  humano = true;\n  texto = `Ahora mismo no puedo responder. Puedes contactarnos en: ${b.cfg.contacto || 'nuestro canal de contacto'}.`;\n}\nreturn [{ json: { mensaje: b.mensaje, sesion: b.sesion, origen: b.origen, conversacion_id: b.conversacion_id, respuesta: texto, fuentes: b.fuentes, necesita_humano: humano } }];\n"
      },
      "id": "30119862-d000-4761-82e4-b6c58b074d1b"
    },
