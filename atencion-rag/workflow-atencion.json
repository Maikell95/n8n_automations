        "text": "={{ `🙋 Un cliente necesita una persona (Atención RAG · n8n)\nSesión: ${$('Interpretar respuesta').item.json.sesion} · ${$('Interpretar respuesta').item.json.origen}\n\nCliente: ${$('Interpretar respuesta').item.json.mensaje}\n\nAsistente: ${$('Interpretar respuesta').item.json.respuesta}` }}",
