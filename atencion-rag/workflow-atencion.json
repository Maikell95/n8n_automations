        }
      },
      "id": "a527d5bb-0e5b-435e-a8d9-26634397f56a"
    },
    {
      "name": "Historial",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "alwaysOutputData": true,
      "position": [
        660,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://TU_PROYECTO.supabase.co/rest/v1/mensajes?conversacion_id=eq.{{ $json.id }}&select=rol,contenido&order=creado_en.desc,id.desc&limit=8",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
